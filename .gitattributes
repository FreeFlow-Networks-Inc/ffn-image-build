# Shell and Python scripts must reach Linux with LF endings. This repo is
# sometimes edited from Windows, where Git for Windows sets core.autocrlf=true
# at system level; without this a CRLF would ship and every script would fail
# with "bad interpreter: /usr/bin/env bash^M".
*.sh    text eol=lf
*.py    text eol=lf
*.conf  text eol=lf
*.rules text eol=lf
*.service text eol=lf
*.frozen  text eol=lf
*defconfig text eol=lf
*.config   text eol=lf
# Binary payload bits, never touched.
*.tgz   binary
*.tar.gz binary
*.xz    binary
*.squashfs binary
ffn-cli binary
