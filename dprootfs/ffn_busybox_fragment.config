# FFN busybox additions, merged over Buildroot's default busybox config.
#
# telnetd is what ffn-cpshd serves the CP shell with, and Buildroot's default
# config has "# CONFIG_TELNETD is not set", which is why ffn-cpsh could never
# work on this rootfs. STANDALONE lets it run without inetd, which is how
# ffn-cpshd invokes it (busybox telnetd -b 127.1.1.2:2323 -l /bin/bash).
#
# Kept as a fragment rather than a full custom busybox config so future
# Buildroot defaults still apply.
CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_FEATURE_TELNETD_INETD_WAIT=y
