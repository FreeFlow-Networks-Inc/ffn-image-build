# FFN NGFW data-plane rootfs -- Octeon III CN7885, MIPS64 BIG-endian, n64 ABI.
#
# Replaces the vendor CentOS 7 tree (EOL June 2024, bash from 2017, python2, no
# rpm/yum so unpatchable, and vendor content that cannot ship under the own-code
# rule). Built from upstream sources by us.
#
# KERNEL HEADERS: the DP runs 4.9.57, but Buildroot 2025.02 no longer offers 4.9
# headers -- 5.4 is the oldest series. glibc takes --enable-kernel from the headers
# version, so building against 5.4 would normally let it assume syscalls our kernel
# lacks. BR2_PACKAGE_GLIBC_KERNEL_COMPAT exists for exactly this ("run on a kernel
# older than the version used for the toolchain headers") and is enabled below. The
# 5.4-vs-4.9 gap is small, but it must be validated by actually running the binaries.
BR2_mips64=y
BR2_mips_octeon3=y
BR2_MIPS_NABI64=y

BR2_KERNEL_HEADERS_5_4=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_GLIBC_KERNEL_COMPAT=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Without SHOW_OTHERS, every package busybox also provides is hidden -- which is why
# coreutils, findutils, grep, sed, gawk and procps-ng silently vanished on the first
# attempt. Real binaries win over the busybox applets at install time.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_HOSTNAME="ffn-dp"
BR2_TARGET_GENERIC_ISSUE="FFN NGFW data plane -- Octeon III CN7885, 40 cores"
BR2_SYSTEM_ENABLE_NLS=y

# the three that were asked for
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y

# a real shell plus what makes coreutils usable as an OS rather than a pile of binaries
BR2_PACKAGE_BASH=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_DIFFUTILS=y
BR2_PACKAGE_PATCH=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_WHICH=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_PCIUTILS=y

BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# squashfs+xz so it drops straight into the existing PCIe delivery path
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y

# ---------------------------------------------------------------------------
# FFN 2026-09-02: gaps found running this rootfs on the CP under upstream 6.18.
# ---------------------------------------------------------------------------
# pip is distributed as a wheel, i.e. a zip, and zipimport cannot decompress it
# without zlib -- "No module named 'zlib'" is what blocked python3 -m ensurepip
# on the CP. libz itself was already in the rootfs; only the CPython binding was
# missing. This is THE fix for having a package manager on this architecture.
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_XZ=y

# Ship pip outright rather than relying on ensurepip's bundled copy.
BR2_PACKAGE_PYTHON_PIP=y

# busybox telnetd for ffn-cpshd -- Buildroot's default config omits it.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="/root/ffn-image-build/dprootfs/ffn_busybox_fragment.config"

# The CP runs its userland from an NFS export on the MP's SSD, which wants a
# tarball to extract; the DP delivery path still wants the squashfs, so keep both.
BR2_TARGET_ROOTFS_TAR=y
